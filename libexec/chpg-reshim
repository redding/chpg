#!/usr/bin/env bash
set -e

: "${CHPG_HOME_DIR:=$HOME/.chpg}"
: "${CHPG_VERSIONS_DIR:=/Applications/Postgres.app/Contents/Versions}"

shims="$CHPG_HOME_DIR/shims"
shim_exec="$CHPG_HOME_DIR/libexec/chpg-shim-exec"
mkdir -p "$shims"

# union of executable basenames across all installed Postgres versions
names="$(
  for vdir in "$CHPG_VERSIONS_DIR"/*/; do
    bindir="$vdir/bin"
    [ -d "$bindir" ] || continue
    for f in "$bindir"/*; do
      [ -f "$f" ] && [ -x "$f" ] && basename "$f"
    done
  done | sort -u
)"

for name in $names; do
  cat > "$shims/$name" <<SHIM
#!/usr/bin/env bash
set -e
exec "$shim_exec" "$name" "\$@"
SHIM
  chmod +x "$shims/$name"
done

# prune stale shims
for shim in "$shims"/*; do
  [ -e "$shim" ] || continue
  name="$(basename "$shim")"
  printf '%s\n' $names | grep -qx "$name" || rm -f "$shim"
done

echo "chpg: reshimmed $(printf '%s\n' $names | grep -c .) commands into $shims"
